{
  "name": "payung",
  "private": true,
  "workspaces": [
    "keeper",
    "app"
  ],
  "scripts": {
    "keeper": "npm run start -w keeper",
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test:contracts": "cd contracts && forge test --no-match-contract Fork",
    "test:fork": "cd contracts && forge test --match-contract PayungFork --fork-url https://rpc.test.mezo.org",
    "test:unit": "node --test shared/mezo.test.mjs shared/odds.test.mjs",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
